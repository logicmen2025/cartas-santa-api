APP_NAME="Cartas a Santa API"
APP_ENV=local
# Se genera con: php artisan key:generate
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=America/Guayaquil

APP_LOCALE=es
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base de datos: SQLite (archivo database/database.sqlite) para levantar sin instalar nada.
DB_CONNECTION=sqlite
# Para MySQL comenta la línea de arriba y usa estas:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=cartas_santa
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log

# ---------------------------------------------------------------
# Seguridad (JWT HS256)
# ---------------------------------------------------------------
# Secreto para firmar los tokens. NO se versiona: se genera con
#   php artisan jwt:secret
JWT_SECRET=
# Vigencia del token en segundos (7200 = 2 horas)
JWT_TTL=7200
JWT_EMISOR=cartas-santa-api

# Contraseña de los usuarios de prueba que crea el seeder
# (jefe@polonorte.test = ELFO_JEFE, elfo@polonorte.test = ELFO).
# Es un dato de demostración local, cámbialo si quieres.
DEMO_PASSWORD=Navidad2026

# ---------------------------------------------------------------
# Servicio SOAP: ListaBuenosTraviesosService
# ---------------------------------------------------------------
# Por defecto apunta al mock local (composer mock-soap).
# Para usar el mock del docente, copia la URL del endpoint (soap:address del WSDL).
LISTA_SOAP_URL=http://127.0.0.1:8001/ListaBuenosTraviesosService
# targetNamespace del WSDL (el prefijo pn: del request)
LISTA_SOAP_NAMESPACE=http://polonorte.beatlech/lista
# soapAction de la operación ConsultarComportamiento en el WSDL
LISTA_SOAP_ACTION=ConsultarComportamiento
# Segundos máximos de espera (el enunciado pide 3)
LISTA_SOAP_TIMEOUT=3

# Permite el header X-Fecha-Simulada para demostrar la regla del 24 de
# diciembre (422). Se ignora siempre que APP_ENV=production.
PERMITIR_FECHA_SIMULADA=true
