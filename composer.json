{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "polonorte/cartas-santa-api",
    "type": "project",
    "description": "API REST del Taller de Santa (Escenario A): cartas, aprobación con la Lista de Buenos y Traviesos (SOAP) y manejo de fallos.",
    "keywords": [
        "laravel",
        "api",
        "soap",
        "jwt"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "firebase/php-jwt": "^6.10 || ^7.0",
        "laravel/framework": "^12.0"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.5.50"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate --ansi",
            "@php artisan jwt:secret --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --seed --force --ansi"
        ],
        "mock-soap": [
            "Composer\\Config::disableProcessTimeout",
            "@php -S 127.0.0.1:8001 mock-soap/servidor.php"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan serve --host=127.0.0.1 --port=8000"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "scripts-descriptions": {
        "setup": "Crea .env, genera APP_KEY y JWT_SECRET, crea la base SQLite y siembra usuarios de prueba",
        "mock-soap": "Levanta el mock local de ListaBuenosTraviesosService en http://127.0.0.1:8001",
        "serve": "Levanta la API en http://127.0.0.1:8000",
        "test": "Corre las pruebas automatizadas"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
