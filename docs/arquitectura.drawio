  <diagram id="arquitectura" name="Arquitectura">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1860" pageHeight="1095" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
                <mxCell id="contenedor" value="API Laravel 12  ·  php artisan serve (:8000)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;dashPattern=3 3;fillColor=#fcfcfd;strokeColor=#868e96;verticalAlign=bottom;align=right;spacingRight=12;spacingBottom=8;fontStyle=1;fontColor=#868e96;" vertex="1" parent="1"><mxGeometry x="290" y="70" width="1130" height="995" as="geometry"/></mxCell>
        <mxCell id="titulo" value="&lt;b&gt;Arquitectura · Cartas a Santa (Escenario A)&lt;/b&gt;" style="text;html=1;fontSize=22;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="900" height="30" as="geometry"/></mxCell>
        <mxCell id="c_cliente" value="&lt;b&gt;&lt;font color=&#x27;#495057&#x27;&gt;Cliente&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Postman (colección)&lt;br&gt;JSON +&lt;br&gt;Authorization: Bearer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f3f5;strokeColor=#495057;strokeWidth=2;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="470" width="190" height="130" as="geometry"/></mxCell>
        <mxCell id="c_entrada" value="&lt;b&gt;&lt;font color=&#x27;#3b6fb6&#x27;&gt;Punto de entrada de la API&lt;/font&gt;&lt;/b&gt;&lt;br&gt;public/index.php → bootstrap/app.php&lt;br&gt;grupo api: ForzarRespuestaJson · SimularFecha&lt;br&gt;· ValidarCuerpoJson" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f1ff;strokeColor=#3b6fb6;strokeWidth=2;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="680" y="100" width="420" height="92" as="geometry"/></mxCell>
        <mxCell id="c_rutas" value="&lt;b&gt;&lt;font color=&#x27;#3b6fb6&#x27;&gt;Rutas · routes/api.php&lt;/font&gt;&lt;/b&gt;&lt;br&gt;/api/auth/login · /api/cartas[/{id}[/estado]]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f1ff;strokeColor=#3b6fb6;strokeWidth=2;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="680" y="232" width="420" height="56" as="geometry"/></mxCell>
        <mxCell id="c_seguridad" value="&lt;b&gt;&lt;font color=&#x27;#c77d00&#x27;&gt;Middleware de seguridad&lt;/font&gt;&lt;/b&gt;&lt;br&gt;VerificarRol (rol:ELFO_JEFE) · JWT HS256&lt;br&gt;sin token / token inválido → 401&lt;br&gt;rol distinto → 403" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e0;strokeColor=#c77d00;strokeWidth=2;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="680" y="328" width="420" height="92" as="geometry"/></mxCell>
        <mxCell id="c_controladores" value="&lt;b&gt;&lt;font color=&#x27;#2f8a4c&#x27;&gt;Controladores (delgados)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;CartaController · AuthController&lt;br&gt;FormRequests: validación de formato → 400&lt;br&gt;Resources: arman el JSON de salida" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f6ec;strokeColor=#2f8a4c;strokeWidth=2;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="680" y="460" width="420" height="92" as="geometry"/></mxCell>
        <mxCell id="c_servicios" value="&lt;b&gt;&lt;font color=&#x27;#6f42c1&#x27;&gt;Servicios · REGLAS DE NEGOCIO&lt;/font&gt;&lt;/b&gt;&lt;br&gt;CartaService: reglas 1 a 5 y mapa de transiciones&lt;br&gt;aprobar = consultar la Lista; si falla → RECIBIDA&lt;br&gt;+ PENDIENTE_VERIFICACION y 503&lt;br&gt;AuthService + JwtService (login y tokens)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1ebff;strokeColor=#6f42c1;strokeWidth=2;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="680" y="592" width="420" height="110" as="geometry"/></mxCell>
        <mxCell id="c_repositorio" value="&lt;b&gt;&lt;font color=&#x27;#138496&#x27;&gt;Repositorio&lt;/font&gt;&lt;/b&gt;&lt;br&gt;CartaRepositoryInterface → EloquentCartaRepository" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f6f6;strokeColor=#138496;strokeWidth=2;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="680" y="742" width="420" height="56" as="geometry"/></mxCell>
        <mxCell id="c_modelos" value="&lt;b&gt;&lt;font color=&#x27;#138496&#x27;&gt;Modelos Eloquent&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Carta · User" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f6f6;strokeColor=#138496;strokeWidth=2;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="680" y="838" width="420" height="56" as="geometry"/></mxCell>
        <mxCell id="c_bd" value="&lt;b&gt;&lt;font color=&#x27;#138496&#x27;&gt;Base de datos&lt;/font&gt;&lt;/b&gt;&lt;br&gt;SQLite (por defecto) o MySQL&lt;br&gt;tablas: cartas, users" style="shape=cylinder3;boundedLbl=1;size=12;whiteSpace=wrap;html=1;fillColor=#e6f6f6;strokeColor=#138496;strokeWidth=2;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="780" y="934" width="220" height="108" as="geometry"/></mxCell>
        <mxCell id="c_puerto" value="&lt;b&gt;&lt;font color=&#x27;#d9480f&#x27;&gt;Puerto (interfaz)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;ListaBuenosTraviesosInterface&lt;br&gt;se consulta al aprobar (regla 4)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0e6;strokeColor=#d9480f;strokeWidth=2;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1140" y="592" width="260" height="74" as="geometry"/></mxCell>
        <mxCell id="c_adaptador" value="&lt;b&gt;&lt;font color=&#x27;#d9480f&#x27;&gt;ListaBuenosTraviesosAdapter&lt;/font&gt;&lt;/b&gt;&lt;br&gt;única clase que conoce XML&lt;br&gt;arma el sobre SOAP 1.1&lt;br&gt;lee &amp;lt;resultado&amp;gt; o soap:Fault&lt;br&gt;corta la llamada a los 3 s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0e6;strokeColor=#d9480f;strokeWidth=2;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1140" y="706" width="260" height="150" as="geometry"/></mxCell>
        <mxCell id="c_externo" value="&lt;b&gt;&lt;font color=&#x27;#343a40&#x27;&gt;ListaBuenosTraviesosService&lt;/font&gt;&lt;/b&gt;&lt;br&gt;sistema externo · SOAP 1.1&lt;br&gt;operación ConsultarComportamiento&lt;br&gt;mock local :8001 o mock del docente&lt;br&gt;&amp;quot;Grinch&amp;quot; → soap:Fault" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#343a40;strokeWidth=2;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1520" y="706" width="310" height="150" as="geometry"/></mxCell>
        <mxCell id="c_manejador" value="&lt;b&gt;&lt;font color=&#x27;#c92a2a&#x27;&gt;Manejador global&lt;br&gt;de errores&lt;/font&gt;&lt;/b&gt;&lt;br&gt;ManejadorGlobalDeErrores&lt;br&gt;(bootstrap/app.php →&lt;br&gt;withExceptions)&lt;br&gt;&lt;br&gt;Validación ........... 400&lt;br&gt;JSON roto ............ 400&lt;br&gt;Sin token/inválido ... 401&lt;br&gt;Rol insuficiente ..... 403&lt;br&gt;Carta no existe ...... 404&lt;br&gt;Ruta/método .......... 404/405&lt;br&gt;Conflicto estado ..... 409&lt;br&gt;Regla de negocio ..... 422&lt;br&gt;Lista SOAP caída ..... 503&lt;br&gt;&lt;br&gt;Formato único:&lt;br&gt;{ codigo, mensaje,&lt;br&gt;  detalles, timestamp,&lt;br&gt;  ruta }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecec;strokeColor=#c92a2a;strokeWidth=2;align=left;spacingLeft=10;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="310" y="232" width="250" height="650" as="geometry"/></mxCell>
        <mxCell id="c_fallo" value="&lt;b&gt;&lt;font color=&#x27;#e03131&#x27;&gt;⚠ Aquí se maneja el fallo externo&lt;/font&gt;&lt;/b&gt;&lt;br&gt;soap:Fault o sin respuesta en 3 s:&lt;br&gt;1. el adaptador lanza&lt;br&gt;    ListaNoDisponibleException&lt;br&gt;2. CartaService deja la carta RECIBIDA&lt;br&gt;    + PENDIENTE_VERIFICACION&lt;br&gt;3. responde 503 (formato estándar)&lt;br&gt;La API nunca responde 500" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff5f5;strokeColor=#e03131;strokeWidth=2;dashed=1;align=left;spacingLeft=10;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1520" y="886" width="310" height="172" as="geometry"/></mxCell>
        <mxCell id="f0" value="1. petición HTTP (JSON)" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#343a40;strokeWidth=2;fontColor=#343a40;fontStyle=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="95" y="470" as="sourcePoint"/><mxPoint x="680" y="120" as="targetPoint"/><Array as="points"><mxPoint x="95" y="120"/></Array></mxGeometry></mxCell>
